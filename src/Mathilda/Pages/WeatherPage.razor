@page "/weather"
@using Microsoft.AspNetCore.Components
@using Mathilda.Services
@inject WeatherService Weather
@inject LocationService Location

<h1>Weather</h1>
<p>Current conditions for @_locationName (@_lat.ToString("0.00"), @_lng.ToString("0.00")) — @(_convexConnected ? "server data" : "mock data")</p>

@if (_snapshot is null)
{
    <p><em>Loading weather…</em></p>
}
else
{
    <div class="card">
        <h2>@_snapshot.TempC.ToString("0")°C</h2>
        <p class="muted">@_snapshot.Condition</p>
    </div>

    <h3>Forecast</h3>
    @if (_snapshot.Forecast.Length == 0)
    {
        <p>No forecast available.</p>
    }
    else
    {
        <div class="chip-row">
            @foreach (var f in _snapshot.Forecast)
            {
                <span class="chip">@f</span>
            }
        </div>
    }
}

@code {
    private Mathilda.Models.WeatherSnapshot? _snapshot;
    private double _lat = 13.75;
    private double _lng = 100.5;
    private string _locationName = "Bangkok";
    private bool _convexConnected;

    protected override async Task OnInitializedAsync()
    {
        var loc = await Location.LoadAsync();
        if (loc is { } l)
        {
            _lat = l.Lat;
            _lng = l.Lng;
            _locationName = l.Name;
        }
        _convexConnected = Weather.IsConvexConnected();
        _snapshot = await Weather.Fetch(_lat, _lng);
    }
}
