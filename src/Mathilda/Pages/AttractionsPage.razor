@page "/attractions"
@using Microsoft.AspNetCore.Components
@using Mathilda.Services
@inject PlacesService Places
@inject LocationService Location

<h1>Nearby Attractions</h1>
<p>Places within 10 km of @_locationName (@_lat.ToString("0.00"), @_lng.ToString("0.00")) — @(_convexConnected ? "live data" : "mock data")</p>

@if (_attractions is null)
{
    <p><em>Loading attractions…</em></p>
}
else if (_attractions.Count == 0)
{
    <p>No attractions found nearby.</p>
}
else
{
    <div class="card-grid">
        @foreach (var item in _attractions)
        {
            <div class="card">
                <h3>@item.Name</h3>
                <p class="muted">@item.Type</p>
                <p>Distance: @item.DistanceKm.ToString("0.0") km</p>
                @if (item.OpenNow)
                {
                    <span class="badge badge-open">Open now</span>
                }
                else
                {
                    <span class="badge badge-closed">Closed</span>
                }
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<Mathilda.Models.Attraction>? _attractions;
    private double _lat = 13.75;
    private double _lng = 100.5;
    private string _locationName = "Bangkok";
    private bool _convexConnected;

    protected override async Task OnInitializedAsync()
    {
        var loc = await Location.LoadAsync();
        if (loc is { } l)
        {
            _lat = l.Lat;
            _lng = l.Lng;
            _locationName = l.Name;
        }
        _convexConnected = Places.IsConvexConnected();
        _attractions = await Places.FetchNearby(10, _lat, _lng);
    }
}
